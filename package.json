{
	"name": "mizuki",
	"type": "module",
	"version": "8.2",
	"scripts": {
		"sync-content": "node scripts/sync-content.js",
		"init-content": "node scripts/init-content-repo.js",
		"predev": "node scripts/sync-content.js || true",
		"prebuild": "node scripts/sync-content.js || true",
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"check:content": "node scripts/check-content.mjs",
		"check:comments": "node scripts/check-comments.mjs",
		"check:local": "pnpm check:content && pnpm check:comments && pnpm test && pnpm check",
		"test:content": "node --test scripts/test-content.mjs",
		"test:feed": "node --test scripts/test-feed.mjs",
		"test": "node --test scripts/test-content.mjs scripts/test-feed.mjs scripts/test-comments.mjs scripts/test-font-processing.mjs scripts/test-search.mjs scripts/test-article-images.mjs scripts/test-poster-text.mjs scripts/test-links.mjs scripts/test-migration.mjs scripts/test-performance-budget.mjs scripts/test-album-layout.mjs",
		"test:fonts": "node --test scripts/test-font-processing.mjs",
		"test:comments:browser": "node scripts/test-comments-browser.mjs",
		"test:comments:theme": "node scripts/test-comments-theme.mjs",
		"test:comments:site": "node scripts/test-comments-site.mjs",
		"test:comments:soak": "node scripts/test-comments-site.mjs --soak=20",
		"test:frontend": "node scripts/test-frontend.mjs",
		"test:production-search": "node scripts/test-production-search.mjs",
		"check:performance": "node scripts/check-performance.mjs",
		"check:links": "node scripts/check-links.mjs",
		"check:migration": "node scripts/check-migration.mjs",
		"test:reading": "node scripts/test-reading-experience.mjs",
		"test:article-tools": "node scripts/test-article-tools.mjs",
		"prepare:webfonts": "node scripts/prepare-webfonts.mjs",
		"test:navigation:memory": "node scripts/test-navigation-memory.mjs",
		"update-anime": "node scripts/update-anime.mjs",
		"update-bangumi": "node scripts/update-bangumi.mjs",
		"update-bilibili": "node scripts/update-bilibili.mjs",
		"build": "node scripts/update-anime.mjs && astro build && pagefind --site dist && node scripts/compress-fonts.js",
		"submit": "node scripts/indexnow-submit.js",
		"preview": "astro preview",
		"astro": "astro",
		"type-check": "tsc --noEmit --isolatedDeclarations",
		"new-post": "node scripts/new-post.js",
		"format": "prettier --write ./src",
		"lint": "eslint ./src --fix",
		"preinstall": "npx only-allow pnpm",
		"compress-fonts": "node scripts/compress-fonts.js",
		"test-font-compression": "node --test scripts/test-font-processing.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/svelte": "9.1.1",
		"@expressive-code/core": "^0.44.3",
		"@expressive-code/plugin-collapsible-sections": "^0.44.3",
		"@expressive-code/plugin-line-numbers": "^0.44.3",
		"@fancyapps/ui": "6.1.10",
		"@fontsource-variable/jetbrains-mono": "5.2.8",
		"@fontsource/roboto": "5.2.9",
		"@iconify-json/fa7-brands": "1.2.1",
		"@iconify-json/fa7-regular": "1.2.2",
		"@iconify-json/fa7-solid": "1.2.3",
		"@iconify-json/material-symbols": "1.2.53",
		"@iconify-json/simple-icons": "1.2.69",
		"@iconify/svelte": "^4.2.0",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "0.5.19",
		"astro": "7.4.2",
		"astro-expressive-code": "^0.44.3",
		"astro-icon": "^1.2.0",
		"axios": "^1.20.0",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.23",
		"giscus": "1.6.0",
		"hastscript": "^9.0.1",
		"katex": "^0.19.1",
		"markdown-it": "^14.3.3",
		"marked": "^16.4.2",
		"node-html-parser": "^7.1.0",
		"overlayscrollbars": "2.14.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"qrcode": "^1.5.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^3.0.1",
		"remark-directive-rehype": "^0.4.2",
		"remark-github-admonitions-to-directives": "^1.0.5",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.18.1",
		"satori": "^0.19.3",
		"sharp": "^0.35.5",
		"stylus": "^0.64.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.12",
		"@iconify-json/mdi": "^1.2.3",
		"@rollup/plugin-yaml": "^4.1.2",
		"@types/hast": "^3.0.5",
		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.2",
		"autoprefixer": "^10.6.1",
		"fontmin": "^1.1.1",
		"playwright-core": "1.64.1",
		"postcss-import": "^16.2.0",
		"postcss-nesting": "^13.0.2",
		"prettier": "^3.9.10"
	},
	"packageManager": "pnpm@10.22.0",
	"pnpm": {
		"overrides": {
			"@emmetio/css-parser": "https://codeload.github.com/ramya-rao-a/css-parser/tar.gz/370c480ac103bd17c7bcfb34bf5d577dc40d3660",
			"tar@<7.5.21": "^7.5.21",
			"serialize-javascript@<7.1.3": "^7.1.3",
			"is-svg>fast-xml-parser": "^5.7.0",
			"buffer-to-vinyl>uuid": "^11.1.1",
			"postcss-selector-parser@<7.1.6": "^7.1.6",
			"katex@<0.18.2": "^0.19.1"
		}
	},
	"engines": {
		"node": ">=22.23.4"
	}
}
