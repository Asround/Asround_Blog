---
import { siteConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
// import type { GetStaticPaths } from "astro";
import type { AlbumGroup, Photo } from "../../../types/album";
import { scanAlbums } from "../../../utils/album-scanner";
import { hasMixedPhotoRatios } from "../../../utils/album-layout";

// 检查相册页面是否启用
if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}

export const getStaticPaths = async () => {
	const albumsData = await scanAlbums();
	return albumsData.map((album) => ({
		params: { id: album.id },
		props: { album },
	}));
};

interface Props {
	album: AlbumGroup;
}

const { album } = Astro.props;

if (!album) {
	return Astro.redirect("/404/");
}

const photoLayout = album.layout === "masonry"
	? (hasMixedPhotoRatios(album.photos) ? "masonry" : "balanced")
	: "grid";
---

<MainGridLayout title={album.title} description={album.description || album.title}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      
      <!-- 返回按钮 -->
      <div class="mb-6">
        <a 
          href="/albums/" 
          class="inline-flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-[var(--primary)] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {i18n(I18nKey.albumsBackToList)}
        </a>
      </div>

      <!-- 相册标题信息 -->
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {album.title}
        </h1>
        
        {album.description && (
          <p class="text-neutral-600 dark:text-neutral-400 mb-4">
            {album.description}
          </p>
        )}
        
        <!-- 相册元数据 -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-500 dark:text-neutral-500">
          <span>{album.photos.length} {album.photos.length > 1 ? i18n(I18nKey.albumsPhotosCount) : i18n(I18nKey.albumsPhotoCount)}</span>
          <time>{new Date(album.date).toLocaleDateString('zh-CN')}</time>
          {album.location && (
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
              </svg>
              {album.location}
            </span>
          )}
        </div>
        
        <!-- 标签 -->
        {album.tags && album.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {album.tags.map((tag: string) => (
              <span class="btn-regular h-8 text-sm px-3 rounded-lg">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- 照片网格 -->
      <div 
        class={`photo-gallery ${photoLayout}-layout`}
        data-layout={photoLayout}
        data-columns={album.columns || 3}
      >
        {album.photos.map((photo: Photo, _index: number) => (
          <figure class="photo-item group relative overflow-hidden rounded-lg">
            <a 
              href={photo.src}
              data-no-swup
              data-src={photo.src}
              data-fancybox={`album-${album.id}`}
              class="photo-link block"
            >
              <img 
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                class="photo-image cursor-pointer"
                loading="lazy"
                decoding="async"
                onload="this.removeAttribute('loading')"
              />
            </a>
          </figure>
        ))}
      </div>
    </div>
  </div>

</MainGridLayout>

<style>
  .grid-layout {
    display: grid;
    gap: 1rem;
    align-items: start;
  }
  
  .grid-layout[data-columns="2"] {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  
  .grid-layout[data-columns="3"] {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
  
  .grid-layout[data-columns="4"] {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  
  .masonry-layout {
    column-count: 3;
    column-gap: 1rem;
  }

  .masonry-layout[data-columns="2"] {
    column-count: 2;
  }

  .masonry-layout[data-columns="3"] {
    column-count: 3;
  }

  .masonry-layout[data-columns="4"] {
    column-count: 4;
  }

  .masonry-layout .photo-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  /* 等比例相册保持按行阅读，末行不足一整行时整体居中。 */
  .balanced-layout {
    --album-columns: 3;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1rem;
  }

  .balanced-layout[data-columns="2"] {
    --album-columns: 2;
  }

  .balanced-layout[data-columns="4"] {
    --album-columns: 4;
  }

  .balanced-layout .photo-item {
    flex: 0 0 calc((100% - (var(--album-columns) - 1) * 1rem) / var(--album-columns));
    transition: none;
  }

  .photo-item {
    margin-top: 0;
    min-width: 0;
  }

  .photo-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -3px;
  }

  @media (max-width: 768px) {
    .balanced-layout[data-columns] {
      --album-columns: 2;
    }

    .masonry-layout[data-columns] {
      column-count: 2;
    }
  }

  @media (max-width: 480px) {
    .balanced-layout[data-columns] {
      --album-columns: 1;
    }

    .masonry-layout[data-columns] {
      column-count: 1;
    }
  }

  @media print {
    .masonry-layout[data-columns] {
      column-count: 2;
    }
  }
  
</style>
