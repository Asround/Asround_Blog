---
import type { CollectionEntry } from "astro:content";
import { commentConfig, siteConfig } from "@/config";
import { getPostUrl } from "@/utils/url-utils";
import { getCommentTerm, getDiscussionListUrl, getGiscusStylesheetUrl, shouldShowComments } from "@/utils/comment-utils";
import Giscus from "./Giscus.svelte";
import Twikoo from "./Twikoo.astro";

interface Props {
	post: CollectionEntry<"posts">;
}

const post = Astro.props.post;
const visible = shouldShowComments(commentConfig, post.data);
const provider = commentConfig.provider ?? "twikoo";
const path = getPostUrl(post);
const term = getCommentTerm(path, post.data.commentId);
---
{visible && (
  provider === 'giscus' && commentConfig.giscus ? (
    <Giscus
      client:load
      config={commentConfig.giscus}
      term={term}
      discussionsUrl={getDiscussionListUrl(commentConfig.giscus)}
      stylesheetUrl={getGiscusStylesheetUrl(commentConfig.giscus, import.meta.env.DEV ? Astro.url.origin : siteConfig.siteURL)}
    />
  ) : (
    <div id="article-comments" tabindex="-1" aria-label="评论" class="card-base p-6 mb-4" data-pagefind-ignore data-comment-provider="twikoo">
      <Twikoo path={path} />
    </div>
  )
)}
