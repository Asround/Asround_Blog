---
import { Icon } from "astro-icon/components";
import CollapsibleTOC from "../CollapsibleTOC.svelte";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
---

<div
	class="floating-toc-wrapper"
>
	<button
		id="floating-toc-btn"
		class="floating-toc-btn btn-card"
		aria-label={i18n(I18nKey.tableOfContents)}
		aria-expanded="false"
		aria-controls="floating-toc-panel"
	>
		<svg
			class="progress-ring"
			width="100%"
			height="100%"
			viewBox="0 0 100 100"
		>
			<circle
				class="progress-ring-circle"
				cx="50"
				cy="50"
				r="40"
				fill="transparent"></circle>
		</svg>
		<div class="btn-icon">
			<Icon
				name="material-symbols:format-list-bulleted-rounded"
				class="text-2xl"
			/>
		</div>
	</button>
	<div id="floating-toc-panel" class="floating-toc-panel" inert>
		<div class="floating-toc-panel-content" id="floating-toc-content">
			<CollapsibleTOC client:load />
		</div>
	</div>
</div>

<style>
	.floating-toc-wrapper {
		position: fixed;
		right: 6rem;
		bottom: 15rem;
		z-index: 50;
		pointer-events: auto;
		transform: translateX(5rem);
		display: none;
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.floating-toc-wrapper.active-toc {
		display: block;
	}

	.floating-toc-btn {
		width: 3.75rem;
		height: 3.75rem;
		border-radius: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--primary);
		position: relative;
		background: var(--card-bg);
	}

	.floating-toc-btn.active {
		background: var(--btn-card-bg-active);
	}

	.progress-ring {
		position: absolute;
		top: 0;
		left: 0;
		transform: rotate(-90deg);
		pointer-events: none;
		z-index: 0;
	}

	.progress-ring-circle {
		stroke: var(--primary);
		stroke-width: 5;
		stroke-dasharray: 251.2;
		stroke-dashoffset: 251.2;
		transition: stroke-dashoffset 0.1s linear;
		stroke-linecap: round;
	}

	.btn-icon {
		z-index: 1;
		position: relative;
	}

	.floating-toc-panel {
		position: absolute;
		bottom: 4.5rem;
		right: 0;
		width: 18rem;
		max-height: min(60vh, calc(100dvh - 20.5rem));
		background: var(--card-bg);
		border: 1px solid var(--line-color);
		border-radius: 1rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px) scale(0.95);
		transition: all 0.2s ease;
		pointer-events: none;
	}

	.floating-toc-panel.show {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
		pointer-events: auto;
	}

	.floating-toc-panel-content {
		padding: 0.75rem;
		max-height: min(60vh, calc(100dvh - 20.5rem));
		overflow-y: auto;
		overflow-x: hidden;
	}

	.floating-toc-panel-content::-webkit-scrollbar {
		width: 4px;
	}

	.floating-toc-panel-content::-webkit-scrollbar-track {
		background: transparent;
	}

	.floating-toc-panel-content::-webkit-scrollbar-thumb {
		background: var(--line-color);
		border-radius: 2px;
	}

	@media (max-width: 1560px) {
		.floating-toc-btn {
			box-shadow:
				0 0 0 1px var(--btn-regular-bg),
				0 0 1em var(--btn-regular-bg);
		}
	}

	@media (max-width: 768px) {
		.floating-toc-wrapper {
			transform: none;
			right: 2rem;
			bottom: 6rem;
			opacity: 0.6;
		}

		.floating-toc-wrapper:active,
		.floating-toc-wrapper.active {
			opacity: 1;
		}

		.floating-toc-panel {
			width: 85vw;
			max-width: 20rem;
			right: 0;
			bottom: 4.5rem;
			max-height: min(60vh, calc(100dvh - 11.5rem));
		}

		.floating-toc-panel-content {
			max-height: min(60vh, calc(100dvh - 11.5rem));
		}
	}
</style>

<script>
	import { onPageView } from "../../utils/page-view";

	const wrapper = document.querySelector<HTMLElement>(".floating-toc-wrapper");
	const btn = document.getElementById("floating-toc-btn");
	const panel = document.getElementById("floating-toc-panel");
	const circle = btn?.querySelector<SVGCircleElement>(".progress-ring-circle");

	function setOpen(open: boolean) {
		panel?.classList.toggle("show", open);
		if (panel) panel.inert = !open;
		btn?.classList.toggle("active", open);
		btn?.setAttribute("aria-expanded", String(open));
		wrapper?.classList.toggle("active", open);
	}

	function updateProgress() {
		if (!circle) return;
		const height =
			document.documentElement.scrollHeight -
			document.documentElement.clientHeight;
		const progress =
			height > 0 ? Math.min(1, Math.max(0, window.scrollY / height)) : 0;
		circle.style.strokeDashoffset = String(2 * Math.PI * 40 * (1 - progress));
	}

	function refresh() {
		setOpen(false);
		wrapper?.classList.toggle(
			"active-toc",
			!!document.querySelector(
				"#post-container .custom-md :is(h1, h2, h3, h4, h5, h6)[id]",
			),
		);
		updateProgress();
	}

	btn?.addEventListener("click", () =>
		setOpen(!panel?.classList.contains("show")),
	);
	wrapper?.addEventListener("toc:navigate", () => setOpen(false));
	wrapper?.addEventListener("toc:updated", (event) => {
		const count = (event as CustomEvent<{ count: number }>).detail.count;
		wrapper.classList.toggle("active-toc", count > 0);
		if (!count) setOpen(false);
	});
	document.addEventListener("click", (event) => {
		if (!wrapper?.contains(event.target as Node)) setOpen(false);
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && panel?.classList.contains("show")) {
			setOpen(false);
			btn?.focus();
		}
	});
	window.addEventListener("scroll", updateProgress, { passive: true });
	window.addEventListener("resize", updateProgress);
	onPageView(refresh);
	refresh();
</script>
